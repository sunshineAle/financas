# Copie este arquivo para .env e ajuste os valores antes de rodar em produção

# Destino de instalação: servidor (ZimaOS/Docker) | pc | android. Define o que muda de um lugar para outro.
DESTINO=servidor
PORT=4000
# Endereço em que escuta (padrão: servidor 0.0.0.0, pc/android 127.0.0.1)
# HOST=
# Pasta do banco (no Docker, aponte para o volume persistente)
# DATA_DIR=

# Gere um valor aleatório forte, ex: openssl rand -hex 32
JWT_SECRET=troque-este-valor-por-algo-aleatorio-e-grande

# Duração da sessão "normal" (sem marcar lembrar dispositivo)
JWT_EXPIRES_CURTO=8h

# Duração da sessão quando o usuário marca "lembrar este dispositivo"
JWT_EXPIRES_LONGO=30d

# Em produção, sirva o sistema atrás de HTTPS e mude para "true"
COOKIE_SECURE=false

# URL do frontend, usada para configurar o CORS corretamente
FRONTEND_URL=http://localhost:5173

# --- Open Finance (Pluggy / MeuPluggy) ----------------------------------
# Chaves do painel de desenvolvedor: dashboard.pluggy.ai (Aplicações).
# Sem elas o botão "Conectar banco" avisa que não está configurado.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# "true" mostra também os bancos de teste (Pluggy Bank) no widget
PLUGGY_SANDBOX=false

# Padrão cron da sincronização automática (formato padrão do node-cron).
# Exemplo abaixo: a cada 6 horas.
SINCRONIZACAO_CRON=0 */6 * * *
